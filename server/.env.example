# ─────────────────────────────────────────────────────────────────────────────
# Sequence Multiplayer Server – Environment Variables
# Render and Railway configure PORT automatically
# ─────────────────────────────────────────────────────────────────────────────

# Server listening port (Render/Railway inject this in production)
PORT=3001

# Allowed CORS origins (* for any, or comma-separated list of origins)
CORS_ORIGIN=*

# Environment mode ('development' or 'production')
NODE_ENV=production
