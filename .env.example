# ─────────────────────────────────────────────────────────────────────────────
# Sequence Mobile App – Environment Variables Configuration
# Copy this file to .env or .env.local to customize your settings
# ─────────────────────────────────────────────────────────────────────────────

# Active environment preset: 'development' | 'production'
# In Expo Go (__DEV__=true), defaults to 'development'
# In production release builds, defaults to 'production'
EXPO_PUBLIC_APP_ENV=development

# Direct Server URL override (takes precedence over everything):
# For Local LAN testing (Expo Go / physical phone):
EXPO_PUBLIC_SERVER_URL=http://192.168.29.101:3001

# For Production (Render / Railway):
# EXPO_PUBLIC_SERVER_URL=https://sequence-server.onrender.com

# Optional endpoint presets:
EXPO_PUBLIC_LOCAL_SERVER_URL=http://192.168.29.101:3001
EXPO_PUBLIC_PROD_SERVER_URL=https://sequence-server.onrender.com
