{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "esModuleInterop": true,
    "outDir": ".ts-out",
    "types": ["node", "jest"],
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": ["./shared/*"],
      "@shared": ["./shared/index.ts"]
    }
  },
  "include": ["src/**/*", "shared/**/*", "App.tsx"]
}
